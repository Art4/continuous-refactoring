{
    "name": "example/php-clean",
    "description": "Fully-climbed deterministic PHP tooling tree fixture — every tooling-tree leaf resolved, only structural-scan remains",
    "require": {
        "php": "^8.2",
        "monolog/monolog": "^3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.2",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.12",
        "rector/rector": "^1.0",
        "phpmd/phpmd": "^2.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
